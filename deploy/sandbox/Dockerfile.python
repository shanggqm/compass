FROM public.ecr.aws/docker/library/python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
RUN pip install --no-cache-dir matplotlib==3.10.8 numpy==2.4.0 pandas==2.3.3 \
    && groupadd -g 1000 sandbox && useradd -u 1000 -g 1000 -m sandbox
COPY runner.py collector.py /opt/compass/
USER 1000:1000
WORKDIR /workspace
ENV MPLBACKEND=Agg MPLCONFIGDIR=/tmp/matplotlib OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
CMD ["sleep", "infinity"]
