{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "COMPASS_CONTROLLED_AUTONOMY_ENABLED",
        "COMPASS_HYBRID_WORKFLOW_ENABLED",
        "COMPASS_WORKFLOW_BUDGET_TENANT_ID",
        "COMPASS_WORKFLOW_BUDGET_WORKSPACE_ID",
        "COMPASS_AUTONOMY_MODEL_PROFILES",
        "COMPASS_AUTONOMY_TOKEN_BUDGET",
        "COMPASS_AUTONOMY_COST_BUDGET_MICROUSD",
        "COMPASS_RETAIL_ALLOWED_ENDPOINTS",
        "COMPASS_DATA_ALLOWED_ENDPOINTS",
        "COMPASS_SANDBOX_ENABLED",
        "COMPASS_SANDBOX_DOMAIN",
        "COMPASS_SANDBOX_API_KEY",
        "COMPASS_SANDBOX_IMAGE",
        "COMPASS_SANDBOX_HOST_ID",
        "COMPASS_SANDBOX_VOLUME_PREFIX",
        "COMPASS_SANDBOX_SLOTS",
        "COMPASS_MCP_ALLOWED_ORIGINS",
        "COMPASS_MCP_LOCAL_FIXTURE_ORIGINS",
        "COMPASS_TOOL_BATCH_MODE",
        "COMPASS_TOOL_FAILURE_MODE",
        "COMPASS_REDIS_URL",
        "COMPASS_REDIS_PASSWORD",
        "COMPASS_RUNTIME_STATE_KEY",
        "COMPASS_RUNTIME_EVENT_TOKEN",
        "COMPASS_WEB_AUTHZ_URL",
        "COMPASS_SCHEDULER_TOKEN",
        "COMPASS_RUNTIME_CONSUMER_SLOTS",
        "COMPASS_CONTEXT_RUNTIME_ENABLED",
        "COMPASS_CONTEXT_SNAPSHOT_TTL_DAYS",
        "COMPASS_CONTEXT_SECURITY_MODE",
        "COMPASS_CONTEXTOPS_MCP_ENABLED",
        "COMPASS_CONTEXT_SCOPE_PROFILES",
        "COMPASS_SEMANTIC_WORKSPACES",
        "COMPASS_SEARCH_WORKSPACES",
        "COMPASS_EMBEDDING_PROVIDER_ID",
        "COMPASS_METRIC_DICTIONARY_PATH",
        "COMPASS_RUNTIME_KEY_VERSION",
        "COMPASS_RUNTIME_MAX_ACTIVE",
        "COMPASS_RUNTIME_MAX_BACKLOG",
        "COMPASS_RUNTIME_TENANT_ACTIVE",
        "COMPASS_RUNTIME_TENANT_BACKLOG",
        "COMPASS_RUNTIME_TENANT_OVERRIDES",
        "COMPASS_RUNTIME_LEASE_SECONDS"
      ]
    },
    "seed": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "COMPASS_RETAIL_ALLOWED_ENDPOINTS",
        "COMPASS_RETAIL_RUN_SCOPE",
        "COMPASS_RETAIL_RUN_READONLY_DSN",
        "COMPASS_MODEL_ENCRYPTION_KEY"
      ]
    },
    "build": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "lint": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "typecheck": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "test": {
      "env": ["PYTHON_TOOLCHAIN_ID"]
    },
    "test:integration": {
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "COMPASS_SANDBOX_API_KEY",
        "COMPASS_SANDBOX_FAULT_TESTS",
        "COMPASS_SANDBOX_TEST_DOMAIN",
        "COMPASS_SANDBOX_TEST_HOST",
        "COMPASS_SANDBOX_TEST_SLOTS",
        "COMPASS_SANDBOX_TEST_VOLUME_PREFIX",
        "COMPASS_SANDBOX_TEST_CONTROL_CONTAINER",
        "COMPASS_SANDBOX_TEST_NAS_CONTAINER",
        "COMPASS_REDIS_URL",
        "COMPASS_REDIS_PASSWORD",
        "COMPASS_RUNTIME_STATE_KEY",
        "COMPASS_RUNTIME_EVENT_TOKEN",
        "COMPASS_WEB_AUTHZ_URL",
        "COMPASS_WORKFLOW_E2E_RETAIL_DSN",
        "COMPASS_SANDBOX_DOMAIN",
        "COMPASS_SANDBOX_IMAGE",
        "COMPASS_SANDBOX_HOST_ID",
        "COMPASS_SANDBOX_VOLUME_PREFIX",
        "COMPASS_SANDBOX_SLOTS",
        "COMPASS_AGENT_SERVICE_TOKEN",
        "COMPASS_DURABLE_MATRIX_OUTPUT_DIR"
      ]
    }
  }
}
