# 本地合成数据演示；复制为 .env。勿用于共享或生产环境。
DATABASE_URL=postgresql+psycopg://compass_agent_runtime:compass_agent_runtime_local_only@127.0.0.1:55432/compass_agent
AGENT_MIGRATION_DATABASE_URL=postgresql+psycopg://compass_agent_migrator:compass_agent_migration_local_only@127.0.0.1:55432/compass_agent
AGENT_PROVISION_DATABASE_URL=postgresql://compass:compass_local_only@127.0.0.1:55432/compass
AGENT_API_URL=http://127.0.0.1:8102
# Web 与 Agent 使用同一随机服务令牌；模型加密密钥必须单独生成并安全备份。
# 两项留空时模型入口不可用，原有登录与演示链路仍可运行。
COMPASS_AGENT_SERVICE_TOKEN=
COMPASS_MODEL_ENCRYPTION_KEY=
# 仅允许明确登记的 HTTPS origin。阿里云填写实际工作区域名，多个用逗号分隔。
# System One: add https://api.typesafe.ai for JEV and your Alibaba workspace origin.
COMPASS_MODEL_ALLOWED_ORIGINS=https://api.deepseek.com,https://api.typesafe.ai
# 意图分流使用已有Provider。默认发现已启用的决策/Flash/Pro接入，UUID可显式绑定。
COMPASS_ROUTING_MODE=jev_with_flash
COMPASS_CONTROLLED_AUTONOMY_ENABLED=false
# 仅登记已核验计费上界的模型，字段见 docs/lesson-16-controlled-autonomy.md
COMPASS_AUTONOMY_MODEL_PROFILES=[]
COMPASS_AUTONOMY_TOKEN_BUDGET=10000000
COMPASS_AUTONOMY_COST_BUDGET_MICROUSD=10000000
# COMPASS_ROUTING_JEV_PROVIDER_ID=<已有决策Provider UUID>
# COMPASS_ROUTING_FLASH_PROVIDER_ID=<已有Flash Provider UUID>
# COMPASS_ROUTING_PRO_PROVIDER_ID=<已有Pro Provider UUID>
# 单个 Agent 进程的模型执行容量；逻辑名额须不小于执行槽。
COMPASS_MODEL_MAX_CONCURRENCY=8
COMPASS_MODEL_MAX_INFLIGHT=32
# 可选的本地 Retail 默认连接。准备发布库和工作区后成对配置，运行 pnpm db:seed -F agent 导入。
# JSON 中的 tenantId / workspaceId 必须与 Web 当前课堂范围精确匹配，DSN 使用发布侧受限只读身份。
# 此配置限制运行与测试可用的精确 PostgreSQL 主机和端口。
COMPASS_RETAIL_ALLOWED_ENDPOINTS=127.0.0.1:55432,localhost:55432,postgres:5432
# 通用 PostgreSQL/MySQL 连接另外允许下列端点。远程实例在此显式加入主机和端口。
COMPASS_DATA_ALLOWED_ENDPOINTS=127.0.0.1:5432,localhost:5432,127.0.0.1:3306,localhost:3306,mysql:3306
# COMPASS_RETAIL_RUN_SCOPE={"tenantId":"00000000-0000-4000-8000-000000000001","workspaceId":"00000000-0000-4000-8000-000000000002","release":"retail-dev-20261022b","contentHash":"7ae26405a71589c98ca8379bec1e1ec1ff77e16232ff2e1bf26b6d4501b8183e","role":"<published_a_east_role>","retailTenantId":101,"schema":"core"}
# COMPASS_RETAIL_RUN_READONLY_DSN=postgresql://<a_east login>:<private password>@127.0.0.1:55432/<published retail database>
LITELLM_LOCAL_MODEL_COST_MAP=True
# 第14课观测默认关闭。先 pnpm observability init/up；私有 Key 见 work/observability/agent.env。
# Docker Agent 使用自动生成的 agent.env；宿主开发使用下面的 loopback 地址。
COMPASS_OBSERVABILITY_ENABLED=false
COMPASS_OBSERVABILITY_SAMPLE_RATIO=1
COMPASS_OBSERVABILITY_ENVIRONMENT=local
# 正文采集：未配置时 local 默认开启，其他环境默认关闭。显式 false 可关闭。
# COMPASS_OBSERVABILITY_CAPTURE_CONTENT=false
# 每个 Attempt 的输入、输出分别最多 16 KiB；超长内容保留脱敏预览与截断标记。
COMPASS_OBSERVABILITY_CONTENT_MAX_BYTES=16384
# 留空时每次进程启动生成唯一实例ID；多副本配置时每个值应不同。
COMPASS_OBSERVABILITY_INSTANCE_ID=
COMPASS_LANGFUSE_BASE_URL=http://127.0.0.1:8104
COMPASS_LANGFUSE_PUBLIC_KEY=
COMPASS_LANGFUSE_SECRET_KEY=
# Web 服务端的公开项目页面入口；不含项目 Key。
COMPASS_LANGFUSE_PROJECT_URL=
# Memory 脚手架 smoke 地址；后续 Runtime 工具使用独立服务接口。
MEMORY_API_URL=http://127.0.0.1:8103
COMPASS_DEMO_ENABLED=true

# Web 自有数据库；先运行 pnpm db:provision -F web，再运行 pnpm db:migrate -F web。
WEB_DATABASE_URL=postgresql://compass_web_runtime:compass_web_runtime_local_only@127.0.0.1:55432/compass_web
WEB_MIGRATION_DATABASE_URL=postgresql://compass_web_migrator:compass_web_migration_local_only@127.0.0.1:55432/compass_web
# 仅首次本地 provision 使用，运行服务不读取此凭据。
WEB_PROVISION_DATABASE_URL=postgresql://compass:compass_local_only@127.0.0.1:55432/compass
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8100
WEB_AUTH_ALLOW_LOCAL_HTTP=true
WEB_SESSION_TTL_SECONDS=43200
# 教学 fixture 必须显式选择；自行设置密码后执行 pnpm db:seed -F web -- --fixture teaching。
# WEB_FIXTURE_PASSWORD=

# Lesson 18: pnpm sandbox init writes private settings to work/sandbox/local.env.
# Source that file before pnpm dev -F agent to enable the local Docker/NFS sandbox.
COMPASS_SANDBOX_ENABLED=false
COMPASS_SANDBOX_DOMAIN=127.0.0.1:8112
COMPASS_SANDBOX_IMAGE=compass-sandbox-python:lesson18
COMPASS_SANDBOX_HOST_ID=lesson18-local
COMPASS_SANDBOX_SLOTS=16
COMPASS_SANDBOX_VOLUME_PREFIX=compass-sandbox-slot
COMPASS_MCP_ALLOWED_ORIGINS=
# Explicit local test origins only, comma separated; leave empty in shared deployments.
COMPASS_MCP_LOCAL_FIXTURE_ORIGINS=
COMPASS_TOOL_BATCH_MODE=serial
COMPASS_TOOL_FAILURE_MODE=stop

# Lesson 19: durable Run stream and separately purpose-bound private state.
COMPASS_REDIS_URL=redis://127.0.0.1:56379/0
COMPASS_REDIS_PASSWORD=compass_redis_local_only
# Generate a separate Fernet key; preserve it with Agent backups.
COMPASS_RUNTIME_STATE_KEY=
# Dedicated bearer credential for trusted workflow events; empty disables that endpoint.
COMPASS_RUNTIME_EVENT_TOKEN=
COMPASS_WEB_AUTHZ_URL=http://127.0.0.1:8100/api/internal/analysis/authorize

# Lesson 20: two HTTP-only Worker identities; use independent random tokens outside local demos.
COMPASS_AGENT_REPLICAS=2
COMPASS_RUNTIME_CONSUMER_SLOTS=1
# Publish the packaged prompt library from Web platform management before accepting managed Runs.
COMPASS_CONTEXT_RUNTIME_ENABLED=true
COMPASS_CONTEXT_OPTIMIZATION_ENABLED=true
# Use an absolute shared path for every worker; this private directory is not served by Web.
COMPASS_CONTEXT_RESULTS_ROOT=work/runtime/tool-results
COMPASS_CONTEXT_SCOPE_PROFILES=[]
# Optional local approved metric dictionary file or directory containing current.json.
COMPASS_METRIC_DICTIONARY_PATH=
COMPASS_RUNTIME_KEY_VERSION=local-v1
COMPASS_SCHEDULER_DATABASE_URL=postgresql+psycopg://compass_agent_scheduler:compass_agent_scheduler_local_only@127.0.0.1:55432/compass_agent
COMPASS_SCHEDULER_AGENT_URL=http://127.0.0.1:8102
COMPASS_SCHEDULER_TOKEN=compass_scheduler_local_only
COMPASS_RUNTIME_MAX_ACTIVE=1000
COMPASS_RUNTIME_MAX_BACKLOG=3000
COMPASS_RUNTIME_TENANT_ACTIVE=200
COMPASS_RUNTIME_TENANT_BACKLOG=20
COMPASS_RUNTIME_TENANT_OVERRIDES={}
COMPASS_RUNTIME_LEASE_SECONDS=15

# Enable the published semantic registry for these workspace UUIDs (comma-separated).
COMPASS_SEMANTIC_WORKSPACES=


# Web-owned document directories (absolute paths). Document tools are available by default.
# Optional when exactly one enabled OpenAI Provider is configured.
# COMPASS_EMBEDDING_PROVIDER_ID=<OpenAI Provider UUID>
COMPASS_DOCUMENTS_ROOT=
COMPASS_DOCUMENTS_PIN_DIR=

# ContextOps：脱敏快照保留天数；audit_only 仅允许 local/test 环境。
COMPASS_CONTEXT_SNAPSHOT_TTL_DAYS=14
COMPASS_CONTEXT_SECURITY_MODE=enforce
COMPASS_CONTEXTOPS_MCP_ENABLED=true
